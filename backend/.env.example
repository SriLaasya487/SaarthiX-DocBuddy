# SQLite for local dev; use PostgreSQL in production (Indian cloud region)
DATABASE_URL=sqlite:///./docbuddy.db
# DATABASE_URL=postgresql+psycopg2://docbuddy:docbuddy@db:5432/docbuddy
JWT_SECRET=change-me
DEBUG=true            # when true, OTP is returned in the API response (dev only)
CORS_ORIGINS=http://localhost:5173
FALL_RESPONSE_SECONDS=60
DATA_KEY=change-me-too              # encrypts symptoms/documents/messages at rest
MEDIA_DIR=./media
ADMIN_PHONES=
# --- optional channels (leave empty in dev; messages are then only logged + stored in the outbox) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SMS_URL=
SMS_KEY=
IVR_PROVIDER_URL=
IVR_PROVIDER_KEY=
# --- optional AI companion ---
LLM_API_KEY=
# --- pricing ---
ENFORCE_TIERS=false
